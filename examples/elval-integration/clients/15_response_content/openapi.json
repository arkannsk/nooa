{
  "components": {
    "schemas": {
      "15_response_content.CreateUserResponse": {
        "description": "User creation response",
        "properties": {
          "created_at": {
            "description": "Creation timestamp",
            "type": "string"
          },
          "id": {
            "description": "Created user ID",
            "type": "integer"
          },
          "name": {
            "description": "User name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "15_response_content.ErrorResponse": {
        "description": "Error response",
        "properties": {
          "code": {
            "description": "Error code",
            "type": "integer"
          },
          "message": {
            "description": "Error message",
            "type": "string"
          }
        },
        "type": "object"
      },
      "15_response_content.MultipleResponses": {
        "description": "Multiple response codes",
        "properties": {
          "data": {
            "description": "Data payload",
            "type": "string"
          }
        },
        "type": "object"
      },
      "15_response_content.NoContentType": {
        "description": "Struct without response annotation",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "15_response_content.NoMediaTypes": {
        "description": "Response without media types",
        "type": "object"
      },
      "15_response_content.UserResponse": {
        "description": "Standard user response",
        "properties": {
          "email": {
            "description": "User email",
            "type": "string"
          },
          "id": {
            "description": "User ID",
            "type": "integer"
          },
          "name": {
            "description": "User name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.APIError": {
        "description": "APIError schema",
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "type": "object"
      },
      "models.ValidationError": {
        "description": "ValidationError schema",
        "properties": {
          "detail": {
            "description": "Detailed explanation",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "15 Response Content Demo",
    "description": "Demonstrates @oa:response annotations from elval. Models define HTTP status codes and media types via annotations, and nooa automatically includes these responses in the OpenAPI spec.",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/create": {
      "post": {
        "deprecated": false,
        "description": "CreateUserResponse model defines two @oa:response annotations: status 200 with JSON+XML and status 201 with JSON only. nooa merges these responses into the OpenAPI spec.",
        "operationId": "POSTCreate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/15_response_content.CreateUserResponse"
              }
            }
          },
          "description": "Create user",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.CreateUserResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.CreateUserResponse"
                }
              }
            },
            "description": "github.com/arkannsk/nooa/examples/models/15_response_content.CreateUserResponse"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.CreateUserResponse"
                }
              }
            },
            "description": "User created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create user",
        "tags": [
          "Responses",
          "MultiStatus"
        ]
      }
    },
    "/error": {
      "post": {
        "deprecated": false,
        "description": "ErrorResponse model defines @oa:response annotation with status 400 and media type application/json.",
        "operationId": "POSTError",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request body",
                "type": "object"
              }
            }
          },
          "description": "Error response",
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.ErrorResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Error response",
        "tags": [
          "Responses"
        ]
      }
    },
    "/multi": {
      "get": {
        "deprecated": false,
        "description": "MultipleResponses model defines three @oa:response annotations: status 200, 401, and 500, all with application/json.",
        "operationId": "GETMulti",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.MultipleResponses"
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.MultipleResponses"
                }
              }
            },
            "description": "github.com/arkannsk/nooa/examples/models/15_response_content.MultipleResponses"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.MultipleResponses"
                }
              }
            },
            "description": "github.com/arkannsk/nooa/examples/models/15_response_content.MultipleResponses"
          }
        },
        "summary": "Multiple response codes",
        "tags": [
          "MultiStatus"
        ]
      }
    },
    "/no-content": {
      "get": {
        "deprecated": false,
        "description": "NoContentType has no @oa:response annotation, so no model responses are generated. Only explicit OnSuccess responses apply.",
        "operationId": "GETNo-content",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.NoContentType"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "No response annotation",
        "tags": [
          "Responses"
        ]
      }
    },
    "/no-media": {
      "get": {
        "deprecated": false,
        "description": "NoMediaTypes has @oa:response annotation with empty media types, resulting in a response without content body.",
        "operationId": "GETNo-media",
        "responses": {
          "204": {
            "description": "No content"
          }
        },
        "summary": "No media types",
        "tags": [
          "Responses"
        ]
      }
    },
    "/user": {
      "get": {
        "deprecated": false,
        "description": "UserResponse model defines @oa:response annotation with status 200 and media types application/json and application/xml. nooa automatically includes these responses in the OpenAPI spec.",
        "operationId": "GETUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.UserResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/15_response_content.UserResponse"
                }
              }
            },
            "description": "User retrieved"
          }
        },
        "summary": "Get user response",
        "tags": [
          "Responses",
          "MediaTypes"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Ответы с @oa:response аннотациями",
      "name": "Responses"
    },
    {
      "description": "Разные media types: JSON, XML",
      "name": "MediaTypes"
    },
    {
      "description": "Множественные status code",
      "name": "MultiStatus"
    }
  ]
}