{
  "components": {
    "schemas": {
      "03_nested.Address": {
        "description": "Postal address",
        "properties": {
          "city": {
            "description": "City name",
            "example": "New York",
            "type": "string"
          },
          "country": {
            "description": "Country code (ISO 3166-1 alpha-2)",
            "example": "US",
            "type": "string"
          },
          "street": {
            "description": "Street address",
            "example": "123 Main St",
            "type": "string"
          },
          "zipcode": {
            "description": "Postal code",
            "example": "12345",
            "type": "string"
          }
        },
        "type": "object"
      },
      "03_nested.UserWithAddress": {
        "description": "User with nested address",
        "properties": {
          "billing": {
            "$ref": "#/components/schemas/03_nested.Address"
          },
          "id": {
            "description": "User ID",
            "example": "user_001",
            "type": "string"
          },
          "name": {
            "description": "User name",
            "example": "John Doe",
            "type": "string"
          },
          "shipping": {
            "$ref": "#/components/schemas/03_nested.Address"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "03 Nested Demo",
    "description": "Integration example: nested structures",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/user": {
      "get": {
        "deprecated": false,
        "description": "Returns a user with a nested address",
        "operationId": "GETUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/03_nested.UserWithAddress"
                }
              }
            },
            "description": "User retrieved"
          }
        },
        "summary": "Get nested user",
        "tags": [
          "Nested"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Вложенные структуры и автоматическое обнаружение зависимостей",
      "name": "Nested"
    }
  ]
}