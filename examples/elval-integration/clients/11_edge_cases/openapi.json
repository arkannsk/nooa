{
  "components": {
    "schemas": {
      "11_edge_cases.CircularRefA": {
        "description": "Node A (circular reference)",
        "properties": {
          "b": {
            "$ref": "#/components/schemas/11_edge_cases.CircularRefB"
          }
        },
        "type": "object"
      },
      "11_edge_cases.CircularRefB": {
        "description": "Node B (circular reference)",
        "properties": {
          "a": {
            "$ref": "#/components/schemas/11_edge_cases.CircularRefA"
          }
        },
        "type": "object"
      },
      "11_edge_cases.EmptyStruct": {
        "description": "Empty struct (no fields)",
        "type": "object"
      },
      "11_edge_cases.Nested": {
        "description": "Nested schema",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "11_edge_cases.NumberEdgeValue": {
        "description": "NumberEdgeValue schema",
        "properties": {
          "value": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "11_edge_cases.PointerChain": {
        "description": "Multiple levels of pointers",
        "properties": {
          "level1": {
            "description": "String pointer",
            "type": "string"
          },
          "level2": {
            "description": "Pointer to pointer",
            "type": "object"
          },
          "level3": {
            "$ref": "#/components/schemas/11_edge_cases.Nested"
          }
        },
        "type": "object"
      },
      "11_edge_cases.StringEdgeValue": {
        "description": "StringEdgeValue schema",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "11_edge_cases.WithInterface": {
        "description": "Struct with interface field",
        "properties": {
          "data": {
            "description": "Flexible value",
            "oneOf": [
              {
                "$ref": "#/components/schemas/11_edge_cases.StringEdgeValue"
              },
              {
                "$ref": "#/components/schemas/11_edge_cases.NumberEdgeValue"
              }
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "11_edge_cases.WithUntypedNil": {
        "description": "Struct with nullable fields",
        "properties": {
          "child": {
            "$ref": "#/components/schemas/11_edge_cases.Nested"
          },
          "items": {
            "description": "Nullable slice",
            "type": "object"
          },
          "optional": {
            "description": "Nullable string",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.APIError": {
        "description": "APIError schema",
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "type": "object"
      },
      "models.ValidationError": {
        "description": "ValidationError schema",
        "properties": {
          "detail": {
            "description": "Detailed explanation",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "11 Edge Cases Demo",
    "description": "Integration example: edge cases such as empty structs, pointer chains, circular references, oneOf interfaces, and untyped nil fields",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/circular": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates circular references between two structs (A -\u003e B -\u003e A). Tests that schema generation handles cycles without infinite recursion.",
        "operationId": "GETCircular",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/11_edge_cases.CircularRefA"
                }
              }
            },
            "description": "Circular reference returned"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Circular reference",
        "tags": [
          "Edge Cases"
        ]
      }
    },
    "/empty": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates an empty struct with no fields. The generated schema has no properties and no required fields.",
        "operationId": "GETEmpty",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/11_edge_cases.EmptyStruct"
                }
              }
            },
            "description": "Empty struct returned"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Empty struct",
        "tags": [
          "Edge Cases"
        ]
      }
    },
    "/oneof": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates an any/interface field annotated with @oa:oneOf. The schema generates a oneOf constraint referencing the allowed concrete types.",
        "operationId": "GETOneof",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/11_edge_cases.WithInterface"
                }
              }
            },
            "description": "oneOf interface returned"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Interface with oneOf",
        "tags": [
          "Edge Cases"
        ]
      }
    },
    "/pointer-chain": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates multiple levels of pointers: *string, **string, and *struct. Tests that pointer types are handled correctly in the schema.",
        "operationId": "GETPointer-chain",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/11_edge_cases.PointerChain"
                }
              }
            },
            "description": "Pointer chain returned"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Pointer chain",
        "tags": [
          "Edge Cases"
        ]
      }
    },
    "/untyped-nil": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates nullable pointer fields: *string, *struct, and *[]slice. Tests that untyped nil pointers are represented correctly in the schema.",
        "operationId": "GETUntyped-nil",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/11_edge_cases.WithUntypedNil"
                }
              }
            },
            "description": "Untyped nil struct returned"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Untyped nil fields",
        "tags": [
          "Edge Cases"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
