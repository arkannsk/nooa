{
  "components": {
    "schemas": {
      "02_files_stream.CustomReader": {
        "description": "CustomReader schema",
        "properties": {
          "data": {
            "format": "byte",
            "type": "string"
          },
          "pos": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "02_files_stream.CustomStream": {
        "description": "CustomStream schema",
        "properties": {
          "data": {
            "format": "byte",
            "type": "string"
          },
          "pos": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "02_files_stream.CustomWithAnnotations": {
        "description": "Upload with custom reader types",
        "properties": {
          "avatar": {
            "description": "Custom file reader",
            "example": "custom-avatar.png",
            "format": "binary",
            "type": "string"
          },
          "data": {
            "description": "Data as byte array",
            "example": "SGVsbG8gV29ybGQ=",
            "format": "byte",
            "type": "string"
          },
          "payload": {
            "description": "Raw stream from custom type",
            "example": "custom-stream-data",
            "format": "binary",
            "type": "string"
          }
        },
        "type": "object"
      },
      "02_files_stream.MixedRequest": {
        "description": "Mixed upload request",
        "properties": {
          "categories": {
            "description": "At least one category",
            "example": "[\"category1\", \"category2\"]",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "description": {
            "description": "Optional description",
            "example": "A nice description",
            "type": "string"
          },
          "file": {
            "description": "Main file",
            "example": "main-file.txt",
            "format": "binary",
            "type": "string"
          },
          "tags": {
            "description": "Tags as comma-separated",
            "example": "[\"tag1\", \"tag2\"]",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "userid": {
            "description": "User ID from form",
            "example": "user_123",
            "type": "string"
          }
        },
        "required": [
          "categories"
        ],
        "type": "object"
      },
      "02_files_stream.StandardFileTypes": {
        "description": "Upload request with standard file/stream types",
        "properties": {
          "attachment": {
            "description": "Multipart file",
            "example": "attachment.zip",
            "format": "binary",
            "type": "string"
          },
          "avatar": {
            "description": "Avatar as *os.File",
            "example": "avatar.png",
            "format": "binary",
            "type": "string"
          },
          "data": {
            "description": "Data as base64 []byte",
            "example": "SGVsbG8gV29ybGQ=",
            "format": "byte",
            "type": "string"
          },
          "payload": {
            "description": "Payload as io.Reader",
            "example": "payload-content",
            "format": "binary",
            "type": "string"
          },
          "thumbnail": {
            "description": "Thumbnail as io.ReadCloser",
            "example": "thumb.png",
            "format": "binary",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "02 Files \u0026 Streams Demo",
    "description": "Integration example: file, stream and byte types mapped to OpenAPI schemas",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/custom": {
      "post": {
        "deprecated": false,
        "description": "Demonstrates @oa:file, @oa:stream and @oa:format:byte annotations on custom types",
        "operationId": "POSTCustom",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/02_files_stream.CustomWithAnnotations"
              }
            }
          },
          "description": "Upload with custom annotated types",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/02_files_stream.CustomWithAnnotations"
                }
              }
            },
            "description": "Success"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Custom files uploaded"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Upload with custom annotated types",
        "tags": [
          "FilesStreams"
        ]
      }
    },
    "/mixed": {
      "post": {
        "deprecated": false,
        "description": "Demonstrates a request combining file fields with regular string, slice and optional fields",
        "operationId": "POSTMixed",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/02_files_stream.MixedRequest"
              }
            }
          },
          "description": "Upload with mixed request",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/02_files_stream.MixedRequest"
                }
              }
            },
            "description": "Success"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Mixed upload created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Upload with mixed request",
        "tags": [
          "FilesStreams"
        ]
      }
    },
    "/standard": {
      "post": {
        "deprecated": false,
        "description": "Demonstrates *os.File, io.Reader, io.ReadCloser, []byte and multipart.File mapped to OpenAPI binary/byte formats",
        "operationId": "POSTStandard",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/02_files_stream.StandardFileTypes"
              }
            }
          },
          "description": "Upload with standard file types",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/02_files_stream.StandardFileTypes"
                }
              }
            },
            "description": "Success"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Standard files uploaded"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Upload with standard file types",
        "tags": [
          "FilesStreams"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Файловые типы и потоки в OpenAPI",
      "name": "FilesStreams"
    }
  ]
}