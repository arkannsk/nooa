{
  "components": {
    "schemas": {
      "05_generics.GenericStruct": {
        "description": "Struct using generic wrappers",
        "properties": {
          "age": {
            "description": "Optional age",
            "type": "integer"
          },
          "data": {
            "description": "Result of computation",
            "type": "string"
          },
          "items": {
            "description": "Slice of optional items",
            "items": {
              "$ref": "#/components/schemas/05_generics.Item"
            },
            "type": "array"
          },
          "name": {
            "description": "Optional name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "05_generics.Item": {
        "description": "Generic item",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "05_generics.WithCustomGeneric": {
        "description": "Struct with custom generic type",
        "properties": {
          "value": {
            "description": "Custom generic field (rewritten as string)",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "05 Generics Demo",
    "description": "Integration example: generic types (Option, Result, custom generics)",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/custom-generic": {
      "get": {
        "deprecated": false,
        "description": "Returns a struct with a custom generic type rewritten as string",
        "operationId": "GETCustom-generic",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/05_generics.WithCustomGeneric"
                }
              }
            },
            "description": "Custom generic struct retrieved"
          }
        },
        "summary": "Get custom generic struct",
        "tags": [
          "Generics"
        ]
      }
    },
    "/generic": {
      "get": {
        "deprecated": false,
        "description": "Returns a struct with generic Option and Result fields",
        "operationId": "GETGeneric",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/05_generics.GenericStruct"
                }
              }
            },
            "description": "Generic struct retrieved"
          }
        },
        "summary": "Get generic struct",
        "tags": [
          "Generics"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Generic-типы: Option, Result и пользовательские дженерики",
      "name": "Generics"
    }
  ]
}