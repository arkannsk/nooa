{
  "components": {
    "schemas": {
      "14_struct_tags.JsonTagModel": {
        "description": "Struct with various json tags",
        "properties": {
          "email": {
            "description": "Field with json omitempty",
            "type": "string"
          },
          "firstName": {
            "description": "Field with camelCase json tag",
            "type": "string"
          },
          "notag": {
            "description": "Field without json tag (fallback to lowercase)",
            "type": "string"
          },
          "user_id": {
            "description": "Field with snake_case json tag",
            "type": "string"
          }
        },
        "type": "object"
      },
      "14_struct_tags.MixedTagsModel": {
        "description": "Mixed struct with various tag combinations",
        "properties": {
          "address": {
            "description": "json with omitempty",
            "type": "string"
          },
          "age": {
            "description": "yaml only",
            "type": "integer"
          },
          "first_name": {
            "description": "json tag",
            "type": "string"
          },
          "lastname": {
            "description": "no tag — fallback",
            "type": "string"
          }
        },
        "type": "object"
      },
      "14_struct_tags.XmlTagModel": {
        "description": "Struct with xml tags",
        "properties": {
          "record_id": {
            "description": "Only xml tag (no json, no yaml)",
            "type": "string"
          },
          "title": {
            "description": "All three tags — json wins",
            "type": "string"
          }
        },
        "type": "object"
      },
      "14_struct_tags.YamlTagModel": {
        "description": "Struct with yaml tags",
        "properties": {
          "full_name": {
            "description": "Both json and yaml — json wins",
            "type": "string"
          },
          "user_name": {
            "description": "Only yaml tag (no json)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.APIError": {
        "description": "APIError schema",
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "type": "object"
      },
      "models.ValidationError": {
        "description": "ValidationError schema",
        "properties": {
          "detail": {
            "description": "Detailed explanation",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "14 Struct Tags Demo",
    "description": "Demonstrates how nooa handles struct fields with json, yaml, and xml tags. OpenAPI schema property names are derived from struct tags (json \u003e yaml \u003e xml priority).",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/json": {
      "post": {
        "deprecated": false,
        "description": "Struct with various json tags: snake_case, camelCase, omitempty, and ignored fields (json:\"-\").",
        "operationId": "POSTJson",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/14_struct_tags.JsonTagModel"
              }
            }
          },
          "description": "Handle JSON tags",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.JsonTagModel"
                }
              }
            },
            "description": "JSON tags processed"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Handle JSON tags",
        "tags": [
          "StructTags"
        ]
      }
    },
    "/mixed": {
      "get": {
        "deprecated": false,
        "description": "Struct combining json tags, yaml-only tags, and fields without any tags (fallback to lowercase name).",
        "operationId": "GETMixed",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.MixedTagsModel"
                }
              }
            },
            "description": "Mixed tags processed"
          }
        },
        "summary": "Handle mixed tags",
        "tags": [
          "StructTags"
        ]
      }
    },
    "/xml": {
      "get": {
        "deprecated": false,
        "description": "Struct with xml tags. Priority: json \u003e yaml \u003e xml. If only xml tag is present, it is used for the property name.",
        "operationId": "GETXml",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.XmlTagModel"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.XmlTagModel"
                }
              },
              "text/yaml": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.XmlTagModel"
                }
              }
            },
            "description": "XML tags processed"
          }
        },
        "summary": "Handle XML tags",
        "tags": [
          "StructTags"
        ]
      }
    },
    "/yaml": {
      "get": {
        "deprecated": false,
        "description": "Struct with yaml tags. When both json and yaml tags are present, json takes priority for OpenAPI property names.",
        "operationId": "GETYaml",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.YamlTagModel"
                }
              },
              "text/yaml": {
                "schema": {
                  "$ref": "#/components/schemas/14_struct_tags.YamlTagModel"
                }
              }
            },
            "description": "YAML tags processed"
          }
        },
        "summary": "Handle YAML tags",
        "tags": [
          "StructTags"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Примеры обработки struct тегов: json, yaml, xml",
      "name": "StructTags"
    }
  ]
}