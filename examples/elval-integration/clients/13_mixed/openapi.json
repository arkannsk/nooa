{
  "components": {
    "schemas": {
      "13_mixed.Address": {
        "description": "Address schema",
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "street": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "13_mixed.AdminVariant": {
        "description": "AdminVariant schema",
        "properties": {
          "admin_level": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "13_mixed.MegaStruct": {
        "description": "Comprehensive example with all features",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/13_mixed.Address"
          },
          "avatar": {
            "description": "Avatar image",
            "format": "binary",
            "type": "string"
          },
          "custom_id": {
            "type": "string"
          },
          "email": {
            "description": "Optional email",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "User name",
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "payload": {
            "description": "Raw payload",
            "format": "binary",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ],
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          },
          "thumbnail": {
            "description": "Base64 thumbnail",
            "format": "byte",
            "type": "string"
          },
          "variant": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/13_mixed.UserVariant"
              },
              {
                "$ref": "#/components/schemas/13_mixed.AdminVariant"
              }
            ],
            "type": "object"
          }
        },
        "required": [
          "name",
          "avatar",
          "status"
        ],
        "type": "object"
      },
      "13_mixed.UserVariant": {
        "description": "UserVariant schema",
        "properties": {
          "kind": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.APIError": {
        "description": "APIError schema",
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "type": "object"
      },
      "models.ValidationError": {
        "description": "ValidationError schema",
        "properties": {
          "detail": {
            "description": "Detailed explanation",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "description": "HTTP Basic auth",
        "scheme": "basic",
        "type": "http"
      },
      "bearerAuth": {
        "description": "JWT authorization",
        "scheme": "bearer",
        "type": "http"
      },
      "oauth2": {
        "description": "OAuth2 authorization code flow",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "read": "Read access",
              "write": "Write access"
            },
            "tokenUrl": "https://example.com/oauth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "13 Mixed Features Demo",
    "description": "Comprehensive integration example combining all features: primitives, files/streams, collections, nested structs, generics, polymorphism, HTTP parameters, ignored fields, and custom types",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/address": {
      "get": {
        "deprecated": false,
        "description": "Returns an Address struct, used as a nested field in MegaStruct.",
        "operationId": "GETAddress",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/13_mixed.Address"
                }
              }
            },
            "description": "Address retrieved"
          }
        },
        "summary": "Get address",
        "tags": [
          "Nested"
        ]
      }
    },
    "/mega": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates parsing path, query, and header parameters from a request into the MegaStruct. Fields annotated with @oa:in path/query/header are extracted automatically via ParseRequest().",
        "operationId": "GETMega",
        "parameters": [
          {
            "description": "IncludeDeleted parameter",
            "in": "query",
            "name": "IncludeDeleted",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "APIVersion parameter",
            "in": "header",
            "name": "APIVersion",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/13_mixed.MegaStruct"
                }
              }
            },
            "description": "Mega struct retrieved from parameters"
          }
        },
        "summary": "Get mega struct from HTTP parameters",
        "tags": [
          "Mixed"
        ]
      },
      "post": {
        "deprecated": false,
        "description": "Comprehensive example combining all features: primitives with validators, file/stream fields, enum and slice collections, nested structs, generics, oneOf polymorphism with discriminator, HTTP parameters (path/query/header), ignored fields, and custom types. All constraints defined via @evl:validate and @oa:* annotations.",
        "operationId": "POSTMega",
        "parameters": [
          {
            "description": "IncludeDeleted parameter",
            "in": "query",
            "name": "IncludeDeleted",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "APIVersion parameter",
            "in": "header",
            "name": "APIVersion",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/13_mixed.MegaStruct"
              }
            }
          },
          "description": "Create mega struct",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/13_mixed.MegaStruct"
                }
              }
            },
            "description": "Mega struct created successfully"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create mega struct",
        "tags": [
          "Mixed"
        ]
      }
    },
    "/variant/admin": {
      "get": {
        "deprecated": false,
        "description": "Returns an AdminVariant, one of the polymorphic options in the MegaStruct.Variant oneOf field.",
        "operationId": "GETVariantAdmin",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/13_mixed.AdminVariant"
                }
              }
            },
            "description": "Admin variant retrieved"
          }
        },
        "summary": "Get admin variant",
        "tags": [
          "Variants"
        ]
      }
    },
    "/variant/user": {
      "get": {
        "deprecated": false,
        "description": "Returns a UserVariant, one of the polymorphic options in the MegaStruct.Variant oneOf field.",
        "operationId": "GETVariantUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/13_mixed.UserVariant"
                }
              }
            },
            "description": "User variant retrieved"
          }
        },
        "summary": "Get user variant",
        "tags": [
          "Variants"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": [
        "read",
        "write"
      ]
    }
  ],
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Комплексный пример, объединяющий все фичи nooa",
      "name": "Mixed"
    },
    {
      "description": "Полиморфные варианты: UserVariant и AdminVariant",
      "name": "Variants"
    },
    {
      "description": "Вложенные структуры и их маршруты",
      "name": "Nested"
    }
  ]
}