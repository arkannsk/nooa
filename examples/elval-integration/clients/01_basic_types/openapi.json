{
  "components": {
    "schemas": {
      "01_basic_types.SimplePrimitives": {
        "description": "Struct with all primitive Go types",
        "properties": {
          "active": {
            "description": "Boolean flag",
            "example": true,
            "type": "boolean"
          },
          "bignumber": {
            "description": "64-bit integer",
            "example": 9223372036854776000,
            "type": "integer"
          },
          "count": {
            "description": "Integer field",
            "example": 42,
            "type": "integer"
          },
          "createdat": {
            "description": "Timestamp",
            "example": "2024-01-15T10:30:00Z",
            "type": "string"
          },
          "name": {
            "description": "String field",
            "example": "hello",
            "type": "string"
          },
          "rate": {
            "description": "Float value",
            "example": 3.14,
            "type": "number"
          }
        },
        "type": "object"
      },
      "01_basic_types.WithDefaults": {
        "description": "Struct with default values",
        "properties": {
          "enabled": {
            "description": "Enabled with default",
            "type": "boolean"
          },
          "limit": {
            "description": "Limit with default",
            "type": "integer"
          },
          "status": {
            "description": "Status with default",
            "type": "string"
          }
        },
        "type": "object"
      },
      "01_basic_types.WithPointers": {
        "description": "Struct with pointer fields (nullable in OpenAPI)",
        "properties": {
          "active": {
            "description": "Optional flag",
            "type": "boolean"
          },
          "count": {
            "description": "Optional count",
            "type": "integer"
          },
          "name": {
            "description": "Optional name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.APIError": {
        "description": "APIError schema",
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "required": [
          "title",
          "detail"
        ],
        "type": "object"
      },
      "models.ConflictError": {
        "description": "ConflictError schema",
        "properties": {
          "detail": {
            "description": "Description of the conflict",
            "example": "A user with this email already exists",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 409,
            "type": "integer"
          },
          "title": {
            "description": "Short summary",
            "example": "Conflict",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.ForbiddenError": {
        "description": "ForbiddenError schema",
        "properties": {
          "detail": {
            "description": "Why access was denied",
            "example": "You do not have permission to perform this action",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 403,
            "type": "integer"
          },
          "title": {
            "description": "Short summary",
            "example": "Forbidden",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.NotFoundError": {
        "description": "NotFoundError schema",
        "properties": {
          "detail": {
            "description": "What was not found",
            "example": "Resource with id 'usr_123' does not exist",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 404,
            "type": "integer"
          },
          "title": {
            "description": "Short summary",
            "example": "Not found",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.RateLimitError": {
        "description": "RateLimitError schema",
        "properties": {
          "detail": {
            "description": "Rate limit details",
            "example": "You have exceeded the rate limit. Try again in 60 seconds.",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 429,
            "type": "integer"
          },
          "title": {
            "description": "Short summary",
            "example": "Too many requests",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.UnauthorizedError": {
        "description": "UnauthorizedError schema",
        "properties": {
          "detail": {
            "description": "Why authorization failed",
            "example": "Missing or invalid API key",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 401,
            "type": "integer"
          },
          "title": {
            "description": "Short summary",
            "example": "Unauthorized",
            "type": "string"
          }
        },
        "type": "object"
      },
      "models.ValidationError": {
        "description": "ValidationError schema",
        "properties": {
          "detail": {
            "description": "Detailed explanation",
            "example": "Field 'email' is required",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "example": 400,
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem",
            "example": "Validation failed",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "01 Basic Types Demo",
    "description": "Integration example: primitive Go types mapped to OpenAPI schemas",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/defaults": {
      "post": {
        "deprecated": false,
        "description": "Demonstrates fields with default values in OpenAPI",
        "operationId": "POSTDefaults",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/01_basic_types.WithDefaults"
              }
            }
          },
          "description": "Create with default values",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/01_basic_types.WithDefaults"
                }
              }
            },
            "description": "Success"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Defaults object created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          }
        },
        "summary": "Create with default values",
        "tags": [
          "BasicTypes"
        ]
      }
    },
    "/pointers": {
      "get": {
        "deprecated": false,
        "description": "Demonstrates pointer fields (nullable) in OpenAPI",
        "operationId": "GETPointers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/01_basic_types.WithPointers"
                }
              }
            },
            "description": "Pointer fields retrieved"
          }
        },
        "summary": "Get nullable pointer fields",
        "tags": [
          "BasicTypes"
        ]
      }
    },
    "/primitives": {
      "post": {
        "deprecated": false,
        "description": "Demonstrates all Go primitive types mapped to OpenAPI schemas",
        "operationId": "POSTPrimitives",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/01_basic_types.SimplePrimitives"
              }
            }
          },
          "description": "Create with primitive types",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/01_basic_types.SimplePrimitives"
                }
              }
            },
            "description": "Success"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Primitive object created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ValidationError"
                }
              }
            },
            "description": "Validation failed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/models.UnauthorizedError"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Create with primitive types",
        "tags": [
          "BasicTypes"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local server",
      "url": "."
    }
  ],
  "tags": [
    {
      "description": "Примитивные типы Go и их отображение в OpenAPI",
      "name": "BasicTypes"
    }
  ]
}